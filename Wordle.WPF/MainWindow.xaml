<Window x:Class="Wordle.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wordle" 
        Height="850" 
        Width="500"
        MinHeight="750"
        MinWidth="450"
        WindowStartupLocation="CenterScreen"
        Background="#121213">

    <Window.Resources>

        <!-- COLORS -->
        <SolidColorBrush x:Key="TileBorderBrush"
                         Color="#3A3A3C"/>

        <SolidColorBrush x:Key="TileBackgroundBrush"
                         Color="#121213"/>

        <SolidColorBrush x:Key="CorrectBrush"
                         Color="#538D4E"/>

        <SolidColorBrush x:Key="WrongPositionBrush"
                         Color="#B59F3B"/>

        <SolidColorBrush x:Key="NotInWordBrush"
                         Color="#3A3A3C"/>
        
        <SolidColorBrush x:Key="KeyboardBrush"
                         Color="#818384"/>
        
        <SolidColorBrush x:Key="KeyboardHoverBrush"
                         Color="#A0A1A2"/>
        
        <SolidColorBrush x:Key="KeyboardPressedBrush"
                         Color="#6A6B6C"/>

        <!-- TILE -->
        <Style x:Key="TileTextStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="white"/>

            <Setter Property="FontSize"
                    Value="28"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>
        
        <Style x:Key="TileStyle"
               TargetType="Border">

            <Setter Property="Width"
                    Value="52"/>

            <Setter Property="Height"
                    Value="52"/>

            <Setter Property="BorderThickness"
                    Value="2"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource TileBorderBrush}"/>

            <Setter Property="Background"
                    Value="{StaticResource TileBackgroundBrush}"/>

            <Setter Property="Margin"
                    Value="3"/>
        </Style>
        
        <!-- KEYBOARD -->
        <Style x:Key="KeyboardButtonStyle"
               TargetType="Button">

            <Setter Property="Height" 
                    Value="55"/>
            
            <Setter Property="MinWidth" 
                    Value="35"/>

            <Setter Property="Margin" 
                    Value="3"/>

            <Setter Property="Padding" 
                    Value="8,0"/>

            <Setter Property="FontSize" 
                    Value="15"/>

            <Setter Property="FontWeight" 
                    Value="Bold"/>

            <Setter Property="Foreground" 
                    Value="White"/>

            <Setter Property="Background" 
                    Value="{StaticResource KeyboardBrush}"/>

            <Setter Property="BorderThickness" 
                    Value="0"/>
            
            <Setter Property="Cursor"
                    Value="Hand"/>

            <!-- Remove the blue focus highlight -->
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <!-- Make the button a purely visual Wordle key -->
            <Setter Property="Focusable"
                    Value="False"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <!-- HOVER -->

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.85"/>

                            </Trigger>


                            <!-- PRESSED -->

                            <Trigger Property="IsPressed"
                                    Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.65"/>

                            </Trigger>


                            <!-- DISABLED -->

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>
                        
                    </ControlTemplate>
                    
                </Setter.Value>
                
            </Setter>
            
        </Style>

        <!-- ENTER / BACKSPACE -->
        <Style x:Key="KeyboardSpecialButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource KeyboardButtonStyle}">

            <Setter Property="MinWidth"
                    Value="62"/>

            <Setter Property="FontSize"
                    Value="12"/>
        </Style>

        <!-- NEW GAME -->
        <Style x:Key="NewGameButtonStyle"
               TargetType="Button">

            <Setter Property="Width" 
                    Value="120"/>
            
            <Setter Property="Height" 
                    Value="40"/>

            <Setter Property="FontSize" 
                    Value="14"/>

            <Setter Property="FontWeight" 
                    Value="Bold"/>

            <Setter Property="Foreground" 
                    Value="White"/>

            <Setter Property="Background" 
                    Value="#3A3A3C"/>

            <Setter Property="BorderThickness" 
                    Value="0"/>

        </Style>

    </Window.Resources>

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Grid.Row="0"
                   Text="WORDLE"
                   Foreground="White"
                   FontSize="32"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"
        />

        <!-- GAMEBOARD -->
        <UniformGrid x:Name="GameBoard"
                     Grid.Row="1"
                     Rows="6"
                     Columns="5"
                     HorizontalAlignment="Center"
                     Width="300"
                     Height="360"
        />

        <!-- MESSAGE -->
        <TextBlock x:Name="MessageText"
                   Grid.Row="2"
                   Foreground="White"
                   FontSize="16"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,15,0,10"
        />

        <!-- KEYBOARD -->
        <StackPanel Grid.Row="3"
                    x:Name="Keyboard"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,15">
            
            <!-- Row 1 -->
            <UniformGrid Rows="1"
                         Columns="10">
                
                <Button Content="Q"
                        Tag="q"
                        Style="{StaticResource KeyboardButtonStyle}"
                        Click="KeyboardButton_Click"/>

                <Button Content="W" 
                        Tag="w" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="E" 
                        Tag="e" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="R" 
                        Tag="r" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="T" 
                        Tag="t" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="Y" 
                        Tag="y" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="U" 
                        Tag="u" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="I" 
                        Tag="i" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="O" 
                        Tag="o" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>

                <Button Content="P" 
                        Tag="p" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
            </UniformGrid>
            
            <!-- Row 2 -->
            <UniformGrid Rows="1"
                         Columns="9"
                         Margin="15,0,15,0">

                <Button Content="A" 
                        Tag="a" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="S" 
                        Tag="s" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="D" 
                        Tag="d" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="F" 
                        Tag="f" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="G" 
                        Tag="g" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="H" 
                        Tag="h" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="J" 
                        Tag="j" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="K" 
                        Tag="k" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="L" 
                        Tag="l" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
            </UniformGrid>
            
            <!-- Row 3 -->
            <UniformGrid Rows="1"
                         Columns="9">

                <Button Content="ENTER" 
                        Tag="enter" 
                        Style="{StaticResource KeyboardSpecialButtonStyle}"
                        Click="KeyboardButton_Click"/>
                
                <Button Content="Z" 
                        Tag="z" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="X" 
                        Tag="x" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="C" 
                        Tag="c" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="V" 
                        Tag="v" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="B" 
                        Tag="b" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="N" 
                        Tag="n" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>
                
                <Button Content="M" 
                        Tag="m" 
                        Style="{StaticResource KeyboardButtonStyle}" 
                        Click="KeyboardButton_Click"/>

                <Button Content="⌫" 
                        Tag="backspace" 
                        Style="{StaticResource KeyboardSpecialButtonStyle}" 
                        Click="KeyboardButton_Click"/>
            </UniformGrid>

        </StackPanel>

        <!-- New game -->
        <Button Grid.Row="4"
                Content="NEW GAME"
                Style="{StaticResource NewGameButtonStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,5,0,0"
                Click="NewGameButton_Click"/>
    </Grid>
</Window>
