<Window x:Class="Wordle.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wordle" 
        Height="750" 
        Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#121213">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Grid.Row="0"
                   Text="WORDLE"
                   Foreground="White"
                   FontSize="32"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,25"
        />

        <!-- Spillebræt -->
        <UniformGrid x:Name="GameBoard"
                     Grid.Row="1"
                     Rows="6"
                     Columns="5"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Width="300"
                     Height="360"
        />

        <!-- Besked -->
        <TextBlock x:Name="MessageText"
                   Grid.Row="2"
                   Text=""
                   Foreground="White"
                   FontSize="16"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,20,0,10"
        />

        <!-- Input -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10">

            <TextBox x:Name="GuessInput"
                     Width="100"
                     Height="40"
                     MaxLength="5"
                     FontSize="22"
                     CharacterCasing="Lower"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
            />

            <Button Content="Get"
                    Width="80"
                    Height="40"
                    Margin="10,0,0,0"
                    Click="GuessButton_Click"
            />
        </StackPanel>

        <!-- Knapper -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15">

            <Button Content="Nyt spil"
                    Width="100"
                    Height="35"
                    Click="NewGameButton_Click"
            />

        </StackPanel>

    </Grid>
</Window>
